<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>PriceWatch</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="topbar">
    <h1>PriceWatch</h1>
    <a class="btn btn-primary" href="/new">+ Add watch</a>
  </header>

  <main>
    <% if (error) { %>
      <div class="alert"><%= error %></div>
    <% } %>

    <% if (watches.length === 0 && !error) { %>
      <p class="empty">No watches yet. <a href="/new">Add your first one</a>.</p>
    <% } %>

    <% if (watches.length > 0) { %>
      <table class="watch-table">
        <thead>
          <tr>
            <th></th>
            <th>Name / URL</th>
            <th>Price</th>
            <th>Interval</th>
            <th>Last checked</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% watches.forEach(w => { %>
            <tr>
              <td>
                <span class="dot <%= w.last_error ? 'dot-error' : (w.is_active ? 'dot-ok' : 'dot-paused') %>"></span>
              </td>
              <td>
                <a href="/watches/<%= w.id %>"><%= w.name || w.url %></a>
                <div class="muted small"><%= w.url %></div>
              </td>
              <td><%= w.last_price != null ? w.last_price : '—' %></td>
              <td><%= w.check_interval_minutes %> min</td>
              <td class="small"><%= w.last_checked_at ? new Date(w.last_checked_at).toLocaleString() : 'never' %></td>
              <td>
                <form method="post" action="/watches/<%= w.id %>/check">
                  <button class="btn btn-small" type="submit">Check now</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>
</body>
</html>
