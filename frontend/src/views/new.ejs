<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Add watch - PriceWatch</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="topbar">
    <h1>PriceWatch</h1>
    <a class="btn" href="/">&larr; Back</a>
  </header>

  <main>
    <h2>Add a new watch</h2>

    <% if (error) { %>
      <div class="alert"><%= error %></div>
    <% } %>

    <form method="post" action="/watches" class="form">
      <label>
        Name (optional)
        <input type="text" name="name" value="<%= formValues.name || '' %>" placeholder="e.g. Standing desk" />
      </label>

      <label>
        Listing URL
        <input type="url" name="url" required value="<%= formValues.url || '' %>" placeholder="https://example.com/product/123" />
      </label>

      <label>
        CSS selector for price (optional)
        <input type="text" name="css_selector" value="<%= formValues.css_selector || '' %>" placeholder=".price, #priceblock_ourprice, [itemprop=price]" />
        <span class="hint">Leave blank to auto-detect common price patterns on the page.</span>
      </label>

      <label>
        Notify email
        <input type="email" name="notify_email" required value="<%= formValues.notify_email || '' %>" placeholder="you@example.com" />
      </label>

      <label>
        Check interval (minutes)
        <input type="number" name="check_interval_minutes" min="5" max="10080" value="<%= formValues.check_interval_minutes || 60 %>" />
      </label>

      <button class="btn btn-primary" type="submit">Create watch</button>
    </form>
  </main>
</body>
</html>
