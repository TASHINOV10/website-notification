# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pricewatch

# SMTP (used by the backend to send price-change emails)
# For a quick demo, Gmail works with an "app password":
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
SMTP_USE_TLS=true

# How often (seconds) the backend scheduler wakes up to see which watches are due
SCHEDULER_TICK_SECONDS=60

# Backend API URL as reachable from the *browser* (not from inside the compose
# network) -- the React frontend calls this directly, client-side.
PUBLIC_API_URL=http://localhost:8000
