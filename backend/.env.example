# Copy this to backend/.env for local (non-Docker) development.
# uvicorn/pydantic-settings reads .env from the current working directory,
# so run uvicorn from inside backend/ (see README "Local development").

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pricewatch

# SMTP (used to send price-change emails). For a quick local test, Gmail
# works with an "app password": https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
SMTP_USE_TLS=true

# How often (seconds) the scheduler wakes up to see which watches are due
SCHEDULER_TICK_SECONDS=60
